# Get your API key at https://vybe.fyi/api-pricing
VYBE_DATA_API_KEY=your_api_key_here

# Optional: Vybe API base URL (default: https://api.vybenetwork.xyz)
# VYBE_DATA_API_BASE=https://api.vybenetwork.xyz

# Optional: Server port (default 3001)
# PORT=3001

# Optional: Solana RPC for on-chain balance amounts.
# Priority: SOLANA_RPC_URL → HELIUS_API_KEY → public mainnet.
# HELIUS_API_KEY=your_helius_api_key_here
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: pump.fun price fallback (after Jupiter).
# PUMPFUN_AUTH_TOKEN=your_jwt_if_logged_in
# PUMPFUN_HEADERS_PATH=/path/to/headers.json

# Google Analytics measurement ID. Any length is accepted.
# The page includes the Google tag whenever GA_MEASUREMENT_ID is set.
# GA_MEASUREMENT_ID=G-MEASUREMENTID

# Root verification file. When set, the site serves /{ROOT_TEXT_KEY}.txt
# containing that key as UTF-8 text. Leave unset to omit the file.
# ROOT_TEXT_KEY=your_key_here
